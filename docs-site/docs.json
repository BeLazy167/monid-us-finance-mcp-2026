{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Monid Finance MCP",
  "description": "Financial Datasets-compatible US finance API and MCP server, backed by pay-per-call Monid providers.",
  "colors": {
    "primary": "#1D5F49",
    "light": "#5CBE92",
    "dark": "#113A2D"
  },
  "logo": {
    "light": "/logo/logo-light.svg",
    "dark": "/logo/logo-dark.svg"
  },
  "favicon": "/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "links": [
      {
        "label": "Get an API key",
        "href": "https://monid.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Live API",
      "href": "https://monid-finance-api.fly.dev"
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/BeLazy167/monid-us-finance-mcp-2026"
        },
        {
          "anchor": "Live API",
          "icon": "server",
          "href": "https://monid-finance-api.fly.dev"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Overview",
            "icon": "compass",
            "pages": [
              "overview/introduction",
              "overview/quickstart",
              "overview/authentication",
              "overview/coverage",
              "overview/comparison"
            ]
          },
          {
            "group": "Integrations",
            "icon": "plug",
            "pages": [
              "integrations/mcp-server",
              "integrations/openapi-spec"
            ]
          },
          {
            "group": "Datasets",
            "icon": "database",
            "pages": [
              {
                "group": "Company",
                "icon": "building-2",
                "pages": [
                  "datasets/company/facts"
                ]
              },
              {
                "group": "Financial Statements",
                "icon": "file-text",
                "pages": [
                  "datasets/financial-statements/income-statements",
                  "datasets/financial-statements/balance-sheets",
                  "datasets/financial-statements/cash-flow-statements"
                ]
              },
              {
                "group": "Financial Metrics",
                "icon": "gauge",
                "pages": [
                  "datasets/financial-metrics/historical",
                  "datasets/financial-metrics/snapshot"
                ]
              },
              {
                "group": "Earnings",
                "icon": "megaphone",
                "pages": [
                  "datasets/earnings/earnings"
                ]
              },
              {
                "group": "Stock Prices",
                "icon": "candlestick-chart",
                "pages": [
                  "datasets/prices/historical",
                  "datasets/prices/snapshot"
                ]
              },
              {
                "group": "SEC Filings",
                "icon": "folder",
                "pages": [
                  "datasets/filings/filings",
                  "datasets/filings/filing-items"
                ]
              },
              {
                "group": "News",
                "icon": "newspaper",
                "pages": [
                  "datasets/news/news"
                ]
              },
              {
                "group": "Insider Trades",
                "icon": "user-check",
                "pages": [
                  "datasets/insider-trades/insider-trades"
                ]
              },
              {
                "group": "Search",
                "icon": "search",
                "pages": [
                  "datasets/screener/stock-screener",
                  "datasets/screener/filters"
                ]
              }
            ]
          },
          {
            "group": "Guides",
            "icon": "book-open",
            "pages": [
              "guides/how-to-get-fundamentals",
              "guides/how-to-search-sec-filings",
              "guides/how-to-get-stock-prices",
              "guides/how-to-use-pagination",
              "guides/errors",
              "guides/rate-limits",
              "guides/caching"
            ]
          },
          {
            "group": "MCP Tools",
            "icon": "wrench",
            "pages": [
              "mcp-tools/overview"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "square-terminal",
        "openapi": "api-reference/openapi.json"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/BeLazy167/monid-us-finance-mcp-2026"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": "css-variables"
    },
    "latex": false
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 600
    },
    "body": {
      "family": "Geist",
      "weight": 400
    }
  }
}