# Environment for the Monid Finance server (go/cmd/server). Every variable
# is optional; the defaults below are what the binary uses when unset.
#
# Callers bring their own Monid API key in the X-API-KEY header, so the
# server itself needs no Monid key to run.

# Listen port.
PORT=8080

# Directory served for non-API paths (the landing site).
STATIC_DIR=website

# Monid discovery allowlist: every provider/endpoint the server may call.
ALLOWLIST_PATH=docs/monid_finance_discovery.json

# Append one JSON receipt per Monid call here (provider, endpoint, run id,
# measured cost). Unset disables recording; recording is best-effort and
# never blocks a response.
# RECEIPTS_PATH=receipts/ledger.jsonl

# Token-bucket rate limit per caller key, requests per minute.
RATE_LIMIT_PER_MINUTE=60

# Comma-separated origins allowed for browser calls. Unset reflects any origin.
# CORS_ALLOWED_ORIGINS=https://your-docs-site.example

# Optional keyless demo: requests with no X-API-KEY for the demo tickers
# (AAPL, MSFT, NVDA) run on this operator-funded key under a stricter limit.
# Leave unset to require a key on every request.
# DEMO_MONID_API_KEY=monid_live_...

# Optional allowlist of caller keys. Unset accepts any well-formed key.
# API_KEYS=monid_live_aaa,monid_live_bbb

# Optional cache shared by every machine and kept across deploys. Without
# one, each machine caches in its own memory and a deploy empties it, so a
# first ask pays the provider cost again however often the same question
# has already been answered. Measured 2026-09-06 across all 55 routes: a
# cold ask took a median 5,256ms against 69ms once cached.
#
# Upstash, which needs nothing running alongside this server:
# CACHE_URL=https://your-db.upstash.io
# CACHE_TOKEN=your-upstash-rest-token
#
# Or any Redis, for running this yourself:
# CACHE_URL=redis://localhost:6379
# CACHE_URL=redis://:password@localhost:6379
